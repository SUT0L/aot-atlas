<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RuntimeSourceRoot Condition="'$(RuntimeSourceRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\reference\runtime</RuntimeSourceRoot>
    <RuntimeSourceRepository>$([System.IO.Path]::GetFullPath('$(RuntimeSourceRoot)'))</RuntimeSourceRepository>
    <RuntimeSourceRootWithSlash>$([MSBuild]::EnsureTrailingSlash('$(RuntimeSourceRepository)'))</RuntimeSourceRootWithSlash>
    <RuntimeCommon Condition="'$(ReaderSchema)' != ''">$(RuntimeSourceRootWithSlash)src\coreclr\tools\Common\</RuntimeCommon>
    <DefineConstants Condition="Exists('$(RuntimeCommon)Internal\Metadata\NativeFormat\NativeMetadataReader.cs')">$(DefineConstants);RUNTIME_CHECKS</DefineConstants>
    <DefineConstants Condition="'$(ReaderSchema)' == 'Net8'">$(DefineConstants);READER_NET8</DefineConstants>
    <DefineConstants Condition="'$(ReaderSchema)' == 'Net9'">$(DefineConstants);READER_NET9</DefineConstants>
    <NoWarn Condition="Exists('$(RuntimeCommon)Internal\Metadata\NativeFormat\NativeMetadataReader.cs')">$(NoWarn);CS8603;CS8618;CS8765</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Atlas/Atlas.csproj" />
    <Compile Include="../Atlas.Tests/NativeFixture.cs" Link="NativeFixture.cs" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(RuntimeCommon)Internal\Metadata\NativeFormat\NativeMetadataReader.cs')">
    <Compile Include="$(RuntimeCommon)Internal\NativeFormat\NativeFormatReader*.cs" Exclude="$(RuntimeCommon)Internal\NativeFormat\NativeFormatReader.Metadata.cs" LinkBase="RuntimeSource" />
    <Compile Include="$(RuntimeCommon)Internal\NativeFormat\NativeFormatWriter.Primitives.cs" LinkBase="RuntimeSource" />
    <Compile Include="$(RuntimeCommon)Internal\Metadata\NativeFormat\NativeMetadataReader.cs" LinkBase="RuntimeSource" />
    <Compile Include="$(RuntimeCommon)Internal\Metadata\NativeFormat\NativeFormatReader*Gen.cs" LinkBase="RuntimeSource" />
    <Compile Include="$(RuntimeCommon)Internal\Metadata\NativeFormat\MdBinaryReader*.cs" LinkBase="RuntimeSource" />
  </ItemGroup>
</Project>
